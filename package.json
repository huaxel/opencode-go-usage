{
  "name": "@juanbenjumea/opencode-go-usage",
  "version": "0.3.1",
  "description": "Shared provider usage fetchers for Pi extensions and agentq: OpenCode Go API, Cursor and CommandCode billing, quota-sessions auth.",
  "type": "module",
  "license": "MIT",
  "author": "Juan Benjumea",
  "keywords": [
    "opencode",
    "opencode-go",
    "cursor",
    "commandcode",
    "quota",
    "usage",
    "dashboard"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/huaxel/opencode-go-usage"
  },
  "bugs": {
    "url": "https://github.com/huaxel/opencode-go-usage/issues"
  },
  "homepage": "https://github.com/huaxel/opencode-go-usage#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./types.ts": "./dist/lib/types.js",
    "./dashboard.ts": "./dist/lib/dashboard.js",
    "./fetch.ts": "./dist/lib/fetch.js",
    "./usage-api.ts": "./dist/lib/usage-api.js",
    "./lib/types.ts": "./dist/lib/types.js",
    "./lib/dashboard.ts": "./dist/lib/dashboard.js",
    "./lib/fetch.ts": "./dist/lib/fetch.js",
    "./lib/usage-api.ts": "./dist/lib/usage-api.js",
    "./auth.ts": "./dist/lib/auth/auth.js",
    "./web-sessions.ts": "./dist/lib/auth/web-sessions.js",
    "./cursor.ts": "./dist/lib/cursor/cursor.js",
    "./commandcode.ts": "./dist/lib/commandcode/commandcode.js",
    "./openference.ts": "./dist/lib/openference/openference.js",
    "./format.ts": "./dist/lib/shared/format.js",
    "./quota-types.ts": "./dist/lib/shared/quota-types.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --strict --allowImportingTsExtensions --moduleResolution bundler --module esnext --target esnext --skipLibCheck index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
