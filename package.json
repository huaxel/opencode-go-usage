  },
  "homepage": "https://github.com/huaxel/opencode-go-usage#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./types.ts": "./dist/lib/types.js",
    "./dashboard.ts": "./dist/lib/dashboard.js",
    "./fetch.ts": "./dist/lib/fetch.js",
    "./usage-api.ts": "./dist/lib/usage-api.js",
    "./lib/types.ts": "./dist/lib/types.js",
    "./lib/dashboard.ts": "./dist/lib/dashboard.js",
    "./lib/fetch.ts": "./dist/lib/fetch.js",
    "./lib/usage-api.ts": "./dist/lib/usage-api.js",
    "./auth.ts": "./dist/lib/auth/auth.js",
    "./web-sessions.ts": "./dist/lib/auth/web-sessions.js",
    "./cursor.ts": "./dist/lib/cursor/cursor.js",
    "./commandcode.ts": "./dist/lib/commandcode/commandcode.js",
    "./openference.ts": "./dist/lib/openference/openference.js",
    "./format.ts": "./dist/lib/shared/format.js",
    "./quota-types.ts": "./dist/lib/shared/quota-types.js",
    "./provider.ts": "./dist/lib/provider/index.js",
    "./dispatch.ts": "./dist/lib/provider/dispatch.js",
    "./claude.ts": "./dist/lib/claude/claude.js",
    "./codex.ts": "./dist/lib/codex/codex.js",
    "./cline.ts": "./dist/lib/cline/cline.js",
    "./umans.ts": "./dist/lib/umans/umans.js",
    "./copilot.ts": "./dist/lib/copilot/copilot.js",
    "./gemini.ts": "./dist/lib/gemini/gemini.js",
